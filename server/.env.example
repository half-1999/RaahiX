NODE_ENV=development
PORT=5055
MONGODB_URI=mongodb://127.0.0.1:27017/local_cab_booking
# Set true to auto-start mongodb-memory-server (useful when local MongoDB is not installed)
USE_MEMORY_MONGO=false
# Auto-seed when DB has no users (recommended with USE_MEMORY_MONGO=true)
SEED_ON_START=false

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

CLIENT_URL=http://localhost:5173

EMAIL_PROVIDER=console
EMAIL_FROM=noreply@localcab.example
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

PAYMENT_GATEWAY=razorpay
PAYMENT_KEY_ID=rzp_test_placeholder
PAYMENT_KEY_SECRET=placeholder_secret
PAYMENT_WEBHOOK_SECRET=placeholder_webhook_secret

WHATSAPP_NUMBER=919999999999

SEED_ADMIN_EMAIL=admin@localcab.dev
SEED_ADMIN_PASSWORD=Admin@12345

HOLD_DURATION_MINUTES=10
